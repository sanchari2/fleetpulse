# Keep shell scripts and CI files LF everywhere. Git for Windows defaults to
# CRLF on checkout, which makes bash fail on the shebang and every `then`.
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.tf    text eol=lf
*.tftpl text eol=lf
*.json  text eol=lf
*.md    text eol=lf
Dockerfile text eol=lf
Makefile   text eol=lf
